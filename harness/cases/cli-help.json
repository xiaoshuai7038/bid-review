{
  "name": "cli-help",
  "description": "Verify that the main CLI help entrypoint remains executable.",
  "command": [
    "uv",
    "run",
    "python",
    "-m",
    "app.main",
    "--help"
  ],
  "cwd": "{workspace}",
  "assertions": {
    "exit_code": 0,
    "stdout_contains": [
      "Claude SDK",
      "OpenCode SDK runtime"
    ]
  }
}
